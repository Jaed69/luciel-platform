# Image tag deployed per app, recorded by each app repo's release workflow
# (scripts/record-tag.sh) and read by the deploy. Plain text on purpose: these name public
# images, they are not secrets, and the diff of a bump has to be readable.
#
# This file is the source of truth for what runs in production. To roll one app back,
# revert its `chore(deploy): <APP>_TAG=...` commit.
#
# A variable must be declared here BEFORE its app repo can record into it.
LEMON_TAG=sha-2b5beb8
