# DEV-ONLY values for local runs. Never put real secrets here: this file is committed.
# Use:      docker compose --env-file env/development.env up -d
# Personal overrides (gitignored): env/<name>.local.env, passed as a second --env-file.
# Production config lives in env/production.env (SOPS-encrypted).

IMAGE_TAG=latest
GHCR_OWNER=jaed69
GHCR_PAT=

# Traefik dashboard basic-auth (dummy hash: dashboard login does not work in dev)
TRAEFIK_DASHBOARD_USER=dev
TRAEFIK_DASHBOARD_PASS_HASH=dev-not-secret-hash

# Tours
NEXTAUTH_SECRET=dev-not-secret-nextauth-secret-change-me
NEXTAUTH_URL=http://localhost:3000
JWT_ALGORITHM=HS256
ADMIN_INITIAL_PASSWORD=dev-not-secret-admin-password

# Litestream backup stays off in dev
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
