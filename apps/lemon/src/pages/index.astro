---
import Layout from '../layouts/Layout.astro';

// El "video sorpresa" del primer acto: rickroll adaptado a medida.
const RICKROLL_ID = 'ikK_3_BH5Rg';
const POSTER = `https://i.ytimg.com/vi/${RICKROLL_ID}/hqdefault.jpg`;
---

<Layout title="lemon.luciel.dev — el show de Lemondrea" description="Un regalo de cumpleaños.">
  <div class="lemon-stage" id="stage" data-youtube-id={RICKROLL_ID}>
    <div class="lemon-stage-bulbs" id="bulbs" aria-hidden="true"></div>

    <div class="lemon-stage-inner">
      <div class="lemon-stage-glow"></div>

      <!-- acto 1: poster + play -->
      <div class="lemon-stage-act" id="act-ready" hidden>
        <div class="lemon-stage-title">función especial<br />para Lemondrea</div>
        <div class="lemon-poster" id="poster">
          <img src={POSTER} alt="poster del video sorpresa" loading="eager" />
          <button class="lemon-poster-play" id="play-btn" type="button" aria-label="Reproducir el video sorpresa">
            <span class="tri"></span>
          </button>
        </div>
        <div class="lemon-stage-hint">Tu regalo está cargando... dale play.</div>
      </div>

      <!-- acto 2: cargando -->
      <div class="lemon-stage-act" id="act-loading" hidden>
        <div class="lemon-loader"></div>
        <div class="lemon-loading-label">cargando el número...</div>
      </div>

      <!-- acto 3: el "video" (rickroll de verdad, unos segundos) -->
      <div class="lemon-stage-act" id="act-rickroll" hidden>
        <div class="lemon-poster lemon-glitch" id="rickroll-frame"></div>
        <div class="lemon-stage-hint">te la creíste...</div>
      </div>

      <!-- acto 4: la revelación -->
      <div class="lemon-stage-act" id="act-reveal" hidden>
        <div class="lemon-reveal-title">es broma, no es (solo) un rickroll</div>
        <div class="lemon-stage-hint">el regalo real está en el libro que sigue.</div>
        <a class="lemon-btn-gold" href="/regalo">Pasar al libro →</a>
      </div>
    </div>

    <div class="lemon-curtain lemon-curtain--l"></div>
    <div class="lemon-curtain lemon-curtain--r"></div>

    <!-- telón cerrado -->
    <div class="lemon-marquee-panel" id="marquee">
      <div class="lemon-marquee-title">el show de<br />Lemondrea</div>
      <button class="lemon-btn-gold lemon-btn-gold--pulse" id="open-curtains" type="button">Abrir el telón</button>
      <a class="lemon-skip-link" id="skip-link" href="/regalo" hidden>ya viste el show — ir directo al libro →</a>
    </div>

    <div class="lemon-stage-footlight"></div>
  </div>
</Layout>

<script>
  const INTRO_KEY = 'lemon.introSeen';

  // focos del marco (menos en pantallas chicas: menos nodos animados en móvil)
  const bulbs = document.getElementById('bulbs')!;
  const bulbCount = window.innerWidth < 600 ? 8 : 14;
  for (let i = 0; i < bulbCount; i++) {
    const b = document.createElement('i');
    b.style.animationDelay = `${(i * 0.11).toFixed(2)}s`;
    bulbs.appendChild(b);
  }

  const stage = document.getElementById('stage')!;
  const marquee = document.getElementById('marquee')!;
  const acts = {
    ready: document.getElementById('act-ready')!,
    loading: document.getElementById('act-loading')!,
    rickroll: document.getElementById('act-rickroll')!,
    reveal: document.getElementById('act-reveal')!,
  };

  function show(act: keyof typeof acts) {
    Object.values(acts).forEach((el) => (el.hidden = true));
    acts[act].hidden = false;
  }

  // Visitas repetidas: el telón sigue cerrado (es parte del encanto), pero
  // aparece el atajo directo al libro, que recuerda la página donde quedó.
  let introSeen = false;
  try {
    introSeen = localStorage.getItem(INTRO_KEY) === '1';
  } catch {}
  if (introSeen) document.getElementById('skip-link')!.hidden = false;

  document.getElementById('open-curtains')!.addEventListener('click', () => {
    stage.classList.add('is-open');
    marquee.style.display = 'none';
    setTimeout(() => show('ready'), 1200);
  });

  document.getElementById('play-btn')!.addEventListener('click', () => {
    show('loading');
    setTimeout(() => {
      // el chiste: el "video sorpresa" arranca de verdad
      const frame = document.getElementById('rickroll-frame')!;
      const youtubeId = stage.dataset.youtubeId;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1`;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.title = 'Tu regalo de cumpleaños';
      frame.replaceChildren(iframe);
      show('rickroll');
      setTimeout(() => {
        frame.replaceChildren(); // corta el audio al pasar a la revelación
        show('reveal');
        try {
          localStorage.setItem(INTRO_KEY, '1');
        } catch {}
      }, 8000);
    }, 1200);
  });
</script>
