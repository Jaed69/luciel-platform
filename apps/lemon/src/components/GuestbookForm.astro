---
import type { Message } from '../data/content';
import { avatars } from '../data/avatars';

interface Props {
  approvedMessages: Message[];
}
const { approvedMessages } = Astro.props;

// Emblemas del "canal": mismo set de avatares que las fichas de perfil del
// capítulo II (data/avatars.ts). El elegido tiñe el formulario y viaja con el
// mensaje hacia Supabase (avatar_src + hue), así capítulo II y capítulo IV
// muestran siempre el mismo ícono y color para un mensaje dado.
const emblems = avatars;

const hueFor = (i: number) => emblems[i % emblems.length].hue;
const cards = approvedMessages.map((m, i) => ({
  ...m,
  avatarSrc: m.avatar ?? emblems[i % emblems.length].src,
  accent: `oklch(0.82 0.14 ${hueFor(i)})`,
  glow: `oklch(0.82 0.14 ${hueFor(i)} / .3)`,
  soft: `oklch(0.82 0.14 ${hueFor(i)} / .12)`,
}));
---

<div class="lemon-guest-grid">
  <div class="lemon-guest-list" id="guestbook-notes">
    {cards.map((m) => (
      <div class="lemon-guest-card" style={`--accent:${m.accent}; --glow:${m.glow}; --soft:${m.soft}`}>
        <div class="lemon-guest-glyph"><img src={m.avatarSrc} alt="" loading="lazy" /></div>
        <div class="lemon-guest-body">
          <div class="lemon-guest-name-row"><div class="lemon-guest-name">{m.name}</div></div>
          <div class="lemon-guest-msg">{m.text}</div>
        </div>
      </div>
    ))}
  </div>

  <form class="lemon-guest-form" id="guestbook-form">
    <div class="lemon-guest-form-kicker">NUEVO PERFIL</div>
    <div class="lemon-emblems" id="emblems">
      {emblems.map((e, i) => (
        <button
          class={`lemon-emblem ${i === 0 ? 'is-active' : ''}`}
          type="button"
          data-emblem={i}
          data-src={e.src}
          data-hue={e.hue}
          style={`--c:oklch(0.82 0.14 ${e.hue}); --c-soft:oklch(0.82 0.14 ${e.hue} / .2); --c-glow:oklch(0.82 0.14 ${e.hue} / .5)`}
          aria-label={`Avatar ${i + 1}`}
        >
          <img src={e.src} alt="" />
        </button>
      ))}
    </div>
    <input type="hidden" name="emblem" id="gb-emblem" value={emblems[0].src} data-hue={emblems[0].hue} />
    <input id="gb-name" name="name" placeholder="tu nombre" required autocomplete="name" maxlength="60" />
    <textarea id="gb-message" name="message" placeholder="tu deseo para Lemondrea" rows="4" required maxlength="500"></textarea>
    <button class="lemon-guest-submit" type="submit">ENVIAR SEÑAL <span id="gb-submit-glyph" class="lemon-submit-avatar"><img src={emblems[0].src} alt="" /></span></button>
    <div id="guestbook-status" class="lemon-guest-status" role="status"></div>
    <div class="lemon-guest-note">Tu mensaje se publica al instante acá y en el capítulo de mensajes.</div>
  </form>
</div>

<script>
  import { GUESTBOOK_REST_URL, SUPABASE_ANON_KEY } from '../data/supabase';

  interface GuestbookRow {
    id: number;
    name: string;
    message: string;
    avatar_src: string;
    hue: number;
    created_at: string;
  }

  const supabaseHeaders = {
    apikey: SUPABASE_ANON_KEY,
    Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
  };

  function accentVars(hue: number) {
    return {
      accent: `oklch(0.82 0.14 ${hue})`,
      glow: `oklch(0.82 0.14 ${hue} / .35)`,
      soft: `oklch(0.82 0.14 ${hue} / .12)`,
    };
  }

  // ---------- capítulo IV: tarjeta del libro de visitas ----------
  function renderGuestCard(notesEl: HTMLElement, row: GuestbookRow, prepend: boolean) {
    const { accent, glow, soft } = accentVars(row.hue);
    const card = document.createElement('div');
    card.className = 'lemon-guest-card';
    card.style.setProperty('--accent', accent);
    card.style.setProperty('--glow', glow);
    card.style.setProperty('--soft', soft);

    const glyph = document.createElement('div');
    glyph.className = 'lemon-guest-glyph';
    const avatarImg = document.createElement('img');
    avatarImg.src = row.avatar_src;
    avatarImg.alt = '';
    avatarImg.loading = 'lazy';
    glyph.appendChild(avatarImg);

    const body = document.createElement('div');
    body.className = 'lemon-guest-body';
    const nameRow = document.createElement('div');
    nameRow.className = 'lemon-guest-name-row';
    const name = document.createElement('div');
    name.className = 'lemon-guest-name';
    name.textContent = row.name;
    nameRow.append(name);
    const msg = document.createElement('div');
    msg.className = 'lemon-guest-msg';
    msg.textContent = row.message;
    body.append(nameRow, msg);

    card.append(glyph, body);
    if (prepend) notesEl.prepend(card);
    else notesEl.append(card);
  }

  // ---------- capítulo II: ficha de perfil ----------
  function renderProfileCard(profilesEl: HTMLElement, row: GuestbookRow) {
    const { accent, glow, soft } = accentVars(row.hue);
    const cell = document.createElement('div');
    cell.className = 'lemon-profile-cell';

    const profile = document.createElement('div');
    profile.className = 'lemon-profile';
    profile.style.setProperty('--accent', accent);
    profile.style.setProperty('--glow', glow);
    profile.style.setProperty('--soft', soft);

    const cornerTl = document.createElement('div');
    cornerTl.className = 'corner tl';
    const cornerBr = document.createElement('div');
    cornerBr.className = 'corner br';

    const kicker = document.createElement('div');
    kicker.className = 'lemon-profile-kicker';
    kicker.textContent = 'P R O F I L E';

    const grid = document.createElement('div');
    grid.className = 'lemon-profile-grid';
    const avatar = document.createElement('div');
    avatar.className = 'lemon-avatar';
    const avatarImg = document.createElement('img');
    avatarImg.src = row.avatar_src;
    avatarImg.alt = `avatar de ${row.name}`;
    avatarImg.loading = 'lazy';
    avatar.appendChild(avatarImg);

    const info = document.createElement('div');
    const nameEl = document.createElement('div');
    nameEl.className = 'lemon-profile-name';
    nameEl.textContent = row.name;
    const meta = document.createElement('div');
    meta.className = 'lemon-profile-meta';
    const idLine = document.createElement('div');
    idLine.textContent = `id · #${String(row.id).padStart(4, '0')}`;
    const roleLine = document.createElement('div');
    roleLine.textContent = 'rol · invitade';
    const stateLine = document.createElement('div');
    stateLine.textContent = 'estado · en línea';
    meta.append(idLine, roleLine, stateLine);
    info.append(nameEl, meta);
    grid.append(avatar, info);

    const msg = document.createElement('div');
    msg.className = 'lemon-profile-msg';
    msg.textContent = row.message;

    const foot = document.createElement('div');
    foot.className = 'lemon-profile-foot';
    const sigLabel = document.createElement('div');
    sigLabel.className = 'lemon-profile-sig-label';
    sigLabel.textContent = 'SIGNATURE';
    const sig = document.createElement('div');
    sig.className = 'lemon-profile-sig';
    sig.textContent = row.name;
    foot.append(sigLabel, sig);

    profile.append(cornerTl, cornerBr, kicker, grid, msg, foot);
    cell.appendChild(profile);
    profilesEl.appendChild(cell);
  }

  function bumpProfileCount(by: number) {
    const counter = document.getElementById('profile-count');
    if (!counter) return;
    const current = parseInt(counter.textContent ?? '0', 10) || 0;
    counter.textContent = String(current + by).padStart(2, '0');
  }

  const notesEl = document.getElementById('guestbook-notes');
  const profilesEl = document.getElementById('profiles');
  const form = document.getElementById('guestbook-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('guestbook-status');
  const emblemInput = document.getElementById('gb-emblem') as HTMLInputElement | null;
  const submitGlyph = document.getElementById('gb-submit-glyph');

  let selectedHue = Number(emblemInput?.dataset.hue ?? 200);

  document.querySelectorAll<HTMLElement>('[data-emblem]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-emblem]').forEach((b) => b.classList.toggle('is-active', b === btn));
      const src = btn.dataset.src ?? '';
      selectedHue = Number(btn.dataset.hue ?? 200);
      if (emblemInput) emblemInput.value = src;
      if (submitGlyph) {
        submitGlyph.innerHTML = '';
        const img = document.createElement('img');
        img.src = src;
        img.alt = '';
        submitGlyph.appendChild(img);
      }
      // el color elegido tiñe el formulario entero
      form?.style.setProperty('--accent', `oklch(0.82 0.14 ${selectedHue})`);
    });
  });

  // ---------- carga inicial: trae los mensajes que ya mandaron otros ----------
  (async () => {
    try {
      const res = await fetch(`${GUESTBOOK_REST_URL}?select=*&order=created_at.asc`, {
        headers: supabaseHeaders,
      });
      if (!res.ok) return;
      const rows = (await res.json()) as GuestbookRow[];
      rows.forEach((row) => {
        if (notesEl) renderGuestCard(notesEl, row, false);
        if (profilesEl) renderProfileCard(profilesEl, row);
      });
      if (rows.length) bumpProfileCount(rows.length);
    } catch {
      // sin conexión a Supabase — la página sigue mostrando lo curado a mano
    }
  })();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusEl) return;

    const submitBtn = form.querySelector<HTMLButtonElement>('.lemon-guest-submit');
    const nameInput = form.querySelector<HTMLInputElement>('#gb-name');
    const messageInput = form.querySelector<HTMLTextAreaElement>('#gb-message');

    statusEl.textContent = '';
    statusEl.classList.remove('is-error', 'is-success');
    if (submitBtn) submitBtn.disabled = true;

    try {
      const response = await fetch(GUESTBOOK_REST_URL, {
        method: 'POST',
        headers: {
          ...supabaseHeaders,
          'Content-Type': 'application/json',
          Prefer: 'return=representation',
        },
        body: JSON.stringify({
          name: nameInput?.value.trim() || 'Anónimo',
          message: messageInput?.value.trim() || '',
          avatar_src: emblemInput?.value || '/assets/avatars/avatar-01.png',
          hue: selectedHue,
        }),
      });

      if (!response.ok) throw new Error('submit failed');

      const [row] = (await response.json()) as GuestbookRow[];
      if (row) {
        if (notesEl) renderGuestCard(notesEl, row, true);
        if (profilesEl) renderProfileCard(profilesEl, row);
        bumpProfileCount(1);
      }

      const chosenAvatar = emblemInput?.value;
      form.reset();
      if (emblemInput && chosenAvatar) emblemInput.value = chosenAvatar; // reset() borra el hidden; el avatar elegido se conserva
      statusEl.textContent = 'Señal enviada — ya está publicada.';
      statusEl.classList.add('is-success');
    } catch {
      statusEl.textContent = 'No se pudo enviar tu señal. Probá de nuevo en un momento.';
      statusEl.classList.add('is-error');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
