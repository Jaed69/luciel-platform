<button class="lemon-sound-btn" id="lemon-sound-btn" type="button">
  <span class="lemon-sound-dot" id="lemon-sound-dot"></span>
  <span id="lemon-sound-label">sonido: apagado</span>
</button>
<div class="lemon-music-panel" id="lemon-music-panel" hidden>
  <span class="lemon-music-track" id="lemon-music-track"></span>
  <button class="lemon-music-next" id="lemon-music-next" type="button" aria-label="Siguiente canción">›</button>
</div>
<audio id="lemon-bg-audio" preload="none"></audio>

<script>
  import { playlist } from '../data/music';

  const SOUND_KEY = 'lemon.sound';

  const audio = document.getElementById('lemon-bg-audio') as HTMLAudioElement | null;
  const btn = document.getElementById('lemon-sound-btn');
  const dot = document.getElementById('lemon-sound-dot');
  const label = document.getElementById('lemon-sound-label');
  const panel = document.getElementById('lemon-music-panel');
  const trackLabel = document.getElementById('lemon-music-track');
  const nextBtn = document.getElementById('lemon-music-next');

  let isSoundOn = false;
  let trackIndex = 0;

  function loadTrack(i: number) {
    if (!audio || !playlist.length) return;
    trackIndex = ((i % playlist.length) + playlist.length) % playlist.length;
    const track = playlist[trackIndex];
    audio.src = track.src;
    if (trackLabel) trackLabel.textContent = `${track.title} — ${track.artist}`;
  }

  function playCurrent() {
    if (!audio) return;
    audio.play().catch(() => {}); // el navegador puede seguir bloqueando sin gesto — se reintenta en la siguiente interacción
  }

  function setSound(on: boolean, persist = true) {
    isSoundOn = on;
    if (on) {
      if (!audio?.src) loadTrack(trackIndex);
      playCurrent();
      dot?.classList.add('is-on');
      if (label) label.textContent = 'sonido: activado';
      if (panel) panel.hidden = false;
    } else {
      audio?.pause();
      dot?.classList.remove('is-on');
      if (label) label.textContent = 'sonido: apagado';
      if (panel) panel.hidden = true;
    }
    if (persist) {
      try {
        localStorage.setItem(SOUND_KEY, on ? 'on' : 'off');
      } catch {}
    }
  }

  audio?.addEventListener('ended', () => {
    loadTrack(trackIndex + 1);
    playCurrent();
  });

  nextBtn?.addEventListener('click', () => {
    loadTrack(trackIndex + 1);
    if (isSoundOn) playCurrent();
  });

  btn?.addEventListener('click', () => setSound(!isSoundOn));

  loadTrack(0);

  // Preferencia recordada: por defecto suena solo al abrir el libro (gesto de
  // clic), salvo que el visitante lo haya apagado antes explícitamente.
  let storedPref: string | null = null;
  try {
    storedPref = localStorage.getItem(SOUND_KEY);
  } catch {}
  const wantsSound = storedPref !== 'off';

  function tryAutoplay() {
    if (!wantsSound || isSoundOn) return;
    setSound(true, false);
  }

  // El libro puede abrirse por clic (portada nueva) o ya venir abierto en una
  // página guardada (visita repetida) — sin gesto, el navegador bloquea el
  // audio hasta la primera interacción.
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement)?.closest('#open-cover, #reopen-cover');
    if (target) tryAutoplay();
  });

  const book = document.getElementById('book');
  if (wantsSound && book && !book.hidden) {
    if (label) label.textContent = 'sonido: toca para activar';
    document.addEventListener('pointerdown', tryAutoplay, { once: true });
  }
</script>
