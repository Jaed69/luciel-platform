---
import { useDictionary } from '../i18n';
import { alternates, route } from '../i18n/routes';
import type { Locale, PageKey } from '../i18n/routes';

interface Props {
  page: PageKey;
  locale: Locale;
}

const { page, locale } = Astro.props;
const t = useDictionary(locale);

const links = [
  { key: 'home', label: t.shell.nav.home },
  { key: 'projects', label: t.shell.nav.projects },
] as const;
const versions = alternates(page);
---

<header class="hud" aria-label={t.shell.statusBar}>
  <div class="wrap">
    <a href={route('home', locale)} class="brand">luciel<span>.</span>dev</a>
    <span>LIM <b id="clock">--:--:--</b></span>
    <span>−12.0464 −77.0428</span>
    <span>{t.shell.depth} <b id="depth">0%</b></span>
    <nav aria-label={t.shell.nav.label}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={route(link.key, locale)} aria-current={link.key === page ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    {versions.length > 1 && (
      <nav class="lang" aria-label={t.shell.language.label}>
        <ul>
          {versions.map((version) => (
            <li>
              <a
                href={version.path}
                lang={version.locale}
                hreflang={version.locale}
                aria-label={t.shell.language.names[version.locale]}
                aria-current={version.locale === locale ? 'true' : undefined}
              >{version.locale.toUpperCase()}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
  <div class="depth-bar" aria-hidden="true"></div>
</header>

<script is:inline>
  (()=>{const c=document.getElementById('clock'),d=document.getElementById('depth'),
  f=new Intl.DateTimeFormat('en-GB',{timeZone:'America/Lima',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}),
  t=()=>{c.textContent=f.format(new Date())},
  s=()=>{const m=document.documentElement.scrollHeight-innerHeight;d.textContent=(m>0?Math.round(scrollY/m*100):0)+'%'};
  t();setInterval(t,1000);addEventListener('scroll',s,{passive:true});addEventListener('resize',s,{passive:true});s()})();
</script>
