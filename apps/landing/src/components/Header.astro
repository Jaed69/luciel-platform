---
import { useDictionary } from '../i18n';
import { alternates, route } from '../i18n/routes';
import type { Locale, PageKey } from '../i18n/routes';

interface Props {
  page: PageKey;
  locale: Locale;
}

const { page, locale } = Astro.props;
const t = useDictionary(locale);

const links = [
  { key: 'home', label: t.shell.nav.home },
  { key: 'projects', label: t.shell.nav.projects },
] as const;
const versions = alternates(page);
---

<header class="hud" aria-label={t.shell.statusBar}>
  <div class="wrap">
    <a href={route('home', locale)} class="brand">luciel<span>.dev</span></a>
    <span>LIM <b id="clock">--:--:--</b></span>
    <span>−12.0464 −77.0428</span>
    <nav aria-label={t.shell.nav.label}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={route(link.key, locale)} aria-current={link.key === page ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    {versions.length > 1 && (
      <nav class="lang" aria-label={t.shell.language.label}>
        <ul>
          {versions.map((version) => (
            <li>
              <a
                href={version.path}
                lang={version.locale}
                hreflang={version.locale}
                aria-label={t.shell.language.names[version.locale]}
                aria-current={version.locale === locale ? 'true' : undefined}
              >{version.locale.toUpperCase()}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <button type="button" id="dim" class="dim" aria-label={t.shell.dimension.toggle} aria-pressed="false">
      <span class="side s" aria-hidden="true">{t.shell.dimension.surface}</span>
      <span class="side d" aria-hidden="true">{t.shell.dimension.depth}</span>
      <kbd aria-hidden="true">D</kbd>
    </button>
  </div>
</header>

{/*
  Clock + dimension switch. The pre-paint half lives in Layout's <head>; this half flips html[data-dimension],
  remembers it, and wraps the flip in a view transition (a circle growing from the button) unless motion is reduced.
  D toggles too, except while typing, on key repeat or with a modifier held.
*/}
<script is:inline>(()=>{const r=document.documentElement,c=document.getElementById('clock'),b=document.getElementById('dim'),f=new Intl.DateTimeFormat('en-GB',{timeZone:'America/Lima',timeStyle:'medium',hourCycle:'h23'}),t=()=>{c.textContent=f.format(new Date())},p=()=>b.setAttribute('aria-pressed',r.dataset.dimension=='depth'),g=()=>{const n=r.dataset.dimension=='depth'?'surface':'depth',k=b.getBoundingClientRect(),s=()=>{r.dataset.dimension=n;try{localStorage.dim=n}catch(e){}p()};r.style.setProperty('--vx',k.x+k.width/2+'px');r.style.setProperty('--vy',k.y+k.height/2+'px');document.startViewTransition&&!matchMedia('(prefers-reduced-motion: reduce)').matches?document.startViewTransition(s):s()};b.onclick=g;addEventListener('keydown',e=>{!/^d$/i.test(e.key)||e.ctrlKey||e.metaKey||e.altKey||e.repeat||e.target.closest('input,textarea,select,[contenteditable]')||g()});t();setInterval(t,1000);p()})();</script>
