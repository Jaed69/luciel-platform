---
import Mark from './Mark.astro';
import { useDictionary } from '../i18n';
import { alternates, route } from '../i18n/routes';
import type { Locale, PageKey } from '../i18n/routes';

interface Props {
  page: PageKey;
  locale: Locale;
}

const { page, locale } = Astro.props;
const t = useDictionary(locale);

// Work is a section of the home, so it is never the current page; the other three are pages of their own.
const links = [
  { key: 'work', href: `${route('home', locale)}#work`, label: t.shell.nav.work },
  { key: 'lab', href: route('lab', locale), label: t.shell.nav.lab },
  { key: 'projects', href: route('projects', locale), label: t.shell.nav.projects },
  { key: 'contact', href: route('contact', locale), label: t.shell.nav.contact },
] as const;
const versions = alternates(page);
// On the home the rail sits over the hero image instead of above the page.
const over = page === 'home';
---

<header class:list={['hud', over && 'over']} aria-label={t.shell.statusBar}>
  <div class="wrap">
    <a href={route('home', locale)} class="brand" aria-label={t.shell.nav.home}>
      <Mark />
      <span>luciel.dev</span>
    </a>
    <nav aria-label={t.shell.nav.label}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.key === page ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    {versions.length > 1 && (
      <nav class="lang" aria-label={t.shell.language.label}>
        <ul>
          {versions.map((version) => (
            <li>
              <a
                href={version.path}
                lang={version.locale}
                hreflang={version.locale}
                aria-label={t.shell.language.names[version.locale]}
                aria-current={version.locale === locale ? 'true' : undefined}
              >{version.locale.toUpperCase()}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <button type="button" id="dim" class="dim" aria-label={t.shell.dimension.toggle} aria-pressed="false">
      <span class="track" aria-hidden="true"><span class="knob"></span></span>
      <span class="sides" aria-hidden="true"><span class="side s">{t.shell.dimension.surface}</span> / <span class="side d">{t.shell.dimension.depth}</span></span>
      <kbd aria-hidden="true">D</kbd>
    </button>
  </div>
</header>

{/*
  Dimension switch. The pre-paint half lives in Layout's <head>; this half flips html[data-dimension],
  remembers it, and wraps the flip in a view transition (a circle growing from the button) unless motion is reduced.
  D toggles too, except while typing, on key repeat or with a modifier held.
  The language links store the chosen language in a lang cookie, so nginx stops redirecting / by Accept-Language.
*/}
<script is:inline>(()=>{const r=document.documentElement,b=document.getElementById('dim'),p=()=>b.setAttribute('aria-pressed',r.dataset.dimension=='depth'),g=()=>{const n=r.dataset.dimension=='depth'?'surface':'depth',k=b.getBoundingClientRect(),s=()=>{r.dataset.dimension=n;try{localStorage.dim=n}catch(e){}p()};r.style.setProperty('--vx',k.x+k.width/2+'px');r.style.setProperty('--vy',k.y+k.height/2+'px');document.startViewTransition&&!matchMedia('(prefers-reduced-motion: reduce)').matches?document.startViewTransition(s):s()};b.onclick=g;addEventListener('keydown',e=>{!/^d$/i.test(e.key)||e.ctrlKey||e.metaKey||e.altKey||e.repeat||e.target.closest('input,textarea,select,[contenteditable]')||g()});document.querySelectorAll('.lang a').forEach(a=>a.onclick=()=>{document.cookie='lang='+a.lang+';path=/;max-age=31536000;samesite=lax'});p()})();</script>
