---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
import { criteria, samples } from '../data/lab';
import backdrop from '../../assets/plates/hero-backdrop.png';
import paper from '../../assets/plates/paper-stack.png';
import { useDictionary } from '../i18n';
import { route } from '../i18n/routes';
import type { Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useDictionary(locale).home;
const lp = useDictionary(locale).labPage;
const h = t.hero;

// Not translated, so they live here once: technology names and the public source links.
const stackItems = [
  ['Python', 'pandas', 'scikit-learn', 'PyTorch', 'TensorFlow'],
  ['Amazon Bedrock', 'LangChain', 'prompt caching'],
  ['SQL', 'PostgreSQL', 'Databricks', 'Power BI'],
  ['FastAPI', 'Docker', 'Traefik', 'AWS'],
];
const repo = 'https://github.com/Jaed69/luciel-platform';
const toursSource = `${repo}/tree/main/apps/tours`;
const sourceLinks = [toursSource, undefined];
const statusClass = ['live', 'build'];
// Each case reads as problem → result on the surface, and as approach → system underneath.
const readings = { surface: ['context', 'outcome'], depth: ['approach', 'system'] } as const;
// The lab door shows the first sample's replayed audit as a receipt: the same findings the lab page reports.
const sample = samples[0];
const criterionLabel = (id: string) => criteria.find((c) => c.id === id)?.label[locale] ?? id;
---

<Layout page="home" locale={locale} title={t.title} description={t.description}>
  <main class="home">
    {/* Every block offers two readings (data-reading); tokens.css renders only the active dimension's. */}
    <section id="intro" class="hero" aria-labelledby="name">
      <div class="stage">
        <img class="backdrop-fill" src={backdrop.src} width={backdrop.width} height={backdrop.height} alt="" aria-hidden="true" />
        <img class="backdrop" src={backdrop.src} width={backdrop.width} height={backdrop.height} alt="" fetchpriority="high" />
        <div class="copy">
          <h1 id="name">Jhamil Peña</h1>
          <p class="role">{h.role}</p>
          <p class="lead">{h.lead}</p>
          <p class="actions">
            <a href={route('lab', locale)}>{h.actions.lab}</a>
            <a href={route('contact', locale)}>{h.actions.contact}</a>
          </p>
        </div>
        <div class="object">
        <img class="paper" src={paper.src} width={paper.width} height={paper.height} alt="" />
        {/* The fields the paper turns into: one fictitious booking, so the demo reads as data, not as decoration. */}
        <dl class="cells" aria-label={h.booking.label}>
          {h.booking.fields.map((field) => (
            <div class="cell"><dt>{field.label}</dt><dd>{field.value}</dd></div>
          ))}
        </dl>
        </div>
        <ul class="cards">
          <li class="card tours"><a href="#work">{h.cards.tours}</a></li>
          <li class="card lab"><a href={route('lab', locale)}>{h.cards.lab}</a></li>
          <li class="card caching"><a href="#work"><b>{h.cards.caching.name}</b> {h.cards.caching.text}</a></li>
        </ul>
      </div>
      <div data-reading="depth" class="hero-depth wrap">
        <div class="head">
          <h2>{t.build.heading}</h2>
        </div>
        <dl class="facts">
          {t.build.facts.map((fact) => (
            <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <div class="wrap">
    <section class="block work" id="work" aria-labelledby="work-h">
      <h2 id="work-h" class="work-h">{t.work.heading}</h2>
      <div class="cases">
        {t.work.cases.map((item, index) => (
          <article class="case">
            <header><h3>{item.name}</h3><span class={`status ${statusClass[index]}`}>{item.status}</span></header>
            {Object.entries(readings).map(([dimension, facets]) => (
              <div class="facets" data-reading={dimension}>
                {facets.map((facet) => (
                  <div class="facet">
                    <span class="label">{t.work.facets[facet]}</span>
                    {facet === 'system' ? <p set:html={item.system} /> : <p>{item[facet]}</p>}
                  </div>
                ))}
              </div>
            ))}
            {sourceLinks[index] && <footer data-reading="depth"><a href={sourceLinks[index]}>{t.work.source}</a></footer>}
          </article>
        ))}
      </div>
    </section>

    <section id="lab" class="block" aria-labelledby="lab-h">
      <div data-reading="surface" class="lab">
        <div class="lab-door">
          <div class="head">
            <h2 id="lab-h">{t.lab.heading}</h2>
            <p>{t.lab.lead}</p>
          </div>
          <p class="lab-foot"><a href={route('lab', locale)} class="btn light">{t.lab.open}</a><span>{t.lab.privacy}</span></p>
          <figure class="receipt-sheet">
            <figcaption><b>{sample.file}</b><span>{sample.title[locale]} · {sample.pages} {lp.pages}</span></figcaption>
            <ol class="receipt">
              {sample.findings.map((finding) => (
                <li>
                  <span class="crit">{criterionLabel(finding.criterion)}</span>
                  <span class={`verdict ${finding.verdict}`}>{lp.verdicts[finding.verdict]}</span>
                  <span class="src">{finding.page ? `${lp.results.page} ${finding.page}` : '—'}</span>
                </li>
              ))}
            </ol>
          </figure>
        </div>
        <ul class="lab-next">
          {t.lab.next.map((item) => (
            <li><h3>{item.name}</h3><p>{item.text}</p><span class="status">{t.lab.status}</span></li>
          ))}
        </ul>
      </div>
      <div data-reading="depth" class="pipeline">
        <div class="head">
          <h2>{t.lab.pipeline.heading}</h2>
        </div>
        <ol class="nodes">
          {t.lab.pipeline.steps.map((step, index) => (
            <li><span class="n">{String(index + 1).padStart(2, '0')}</span><b>{step.name}</b><span>{step.text}</span></li>
          ))}
        </ol>
        <p class="note">{t.lab.pipeline.note}</p>
      </div>
    </section>

    {/* About: the person on the surface, the measurements and tools underneath. */}
    <section class="block" id="trajectory" data-reading="surface" aria-labelledby="traj-h">
      <div class="head">
        <h2 id="traj-h">{t.aboutHeading.heading}</h2>
      </div>
      <div class="about">
        {t.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="head">
        <h3 class="sub">{t.trajectory.heading}</h3>
      </div>
      <ol class="track">
        {t.trajectory.stops.map((stop) => (
          <li class="stop">
            <span class="when">{stop.when}</span>
            <div class="body">
              <h3><span>{stop.title}</span>, {stop.place}</h3>
              <p>{stop.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="block" data-reading="depth" aria-labelledby="proof">
      <div class="head">
        <h2 id="proof">{t.readouts.heading}</h2>
        <p>{t.readouts.intro}</p>
      </div>
      <div class="readouts">
        {t.readouts.items.map((item) => (
          <div class="readout"><span class="val">{item.value}</span><span class="lbl">{item.label}</span><span class="src">{item.source}</span></div>
        ))}
      </div>
    </section>

    <section class="block" id="stack" data-reading="depth" aria-labelledby="stack-h">
      <div class="head">
        <h2 id="stack-h">{t.stack.heading}</h2>
      </div>
      <div class="stack">
        {t.stack.labels.map((label, index) => (
          <div>
            <span class="eyebrow">{label}</span>
            <div class="chips">{stackItems[index].map((item) => <span class="chip">{item}</span>)}</div>
          </div>
        ))}
      </div>
    </section>

    <section id="philosophy" class="block" data-reading="surface" aria-labelledby="philosophy-heading">
      <div class="head">
        <h2 id="philosophy-heading">{t.method.heading}</h2>
      </div>
      <ul class="principles">
        {t.method.principles.map((principle) => (
          <li>
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="tools" class="block" data-reading="depth" aria-labelledby="tools-heading">
      <div class="head">
        <h2 id="tools-heading">{t.tools.heading}</h2>
      </div>
      <ul class="tool-list">
        {projects.map((project) => (
          <li>
            <span class="name">{project.name}</span>
            <span class:list={['tag', project.status === 'live' && 'is-live']}>{project.status === 'live' ? t.tools.live : t.tools.planned}</span>
          </li>
        ))}
      </ul>
      <p class="more"><a href={route('projects', locale)}>{t.tools.more}</a></p>
    </section>

    <section id="closing" class="block closing" aria-labelledby="closing-h">
      <div data-reading="surface" class="head closing-stage">
        <img class="backdrop" src={backdrop.src} width={backdrop.width} height={backdrop.height} alt="" loading="lazy" />
        <h2 id="closing-h">{t.closing.heading}</h2>
        <p>{t.closing.lead}</p>
        <p class="ctas"><a href={route('contact', locale)} class="btn light">{t.closing.contact}</a></p>
      </div>
      <div data-reading="depth" class="head">
        <h2>{t.closing.depthHeading}</h2>
        <p>{t.closing.depthLead}</p>
        <p class="ctas"><a href={repo} class="btn">{t.closing.source}</a></p>
      </div>
    </section>
    </div>
  </main>
</Layout>

<style is:global>
  /* ---------- hero ----------
     The first viewport is the approved comp, measured at 1376 px wide: every box below is in comp pixels,
     scaled by --u (one comp pixel) so the composition holds its proportions. Past 1376 px it stops growing:
     the frame stays at comp size, centered by --x, and the same image, blurred, fills the wall on either side. */
  .hero { container-type: inline-size; }
  .stage {
    --u: min(100cqw / 1376, 1px); --x: max(0px, (100cqw - 1376px) / 2);
    position: relative; z-index: 2; height: calc(636 * var(--u)); overflow: hidden;
    color: var(--hero-ink);
  }
  .stage .backdrop { position: absolute; top: 0; left: var(--x); width: calc(1376 * var(--u)); height: 100%; object-fit: cover; filter: brightness(0.74) contrast(1.04); }
  .stage .backdrop-fill { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: blur(28px) brightness(0.74) contrast(1.04); transform: scale(1.08); }
  @container (min-width: 1377px) {
    .stage .backdrop { mask-image: linear-gradient(to right, transparent, #000 9%, #000 91%, transparent); }
  }
  .stage .copy { position: absolute; left: calc(var(--x) + 150 * var(--u)); top: calc(215 * var(--u)); width: calc(372 * var(--u)); }
  .stage h1 { font-family: var(--font-body); font-size: calc(56 * var(--u)); line-height: 1.12; letter-spacing: -0.012em; color: var(--hero-ink); }
  .stage .role { font-size: calc(35 * var(--u)); line-height: 1.25; letter-spacing: -0.01em; color: var(--hero-ink-soft); white-space: nowrap; }
  .stage .lead { max-width: calc(330 * var(--u)); margin-top: calc(22 * var(--u)); font-size: calc(31 * var(--u)); font-weight: 300; line-height: 1.13; letter-spacing: -0.012em; }
  .stage .actions { display: flex; gap: calc(26 * var(--u)); margin-top: calc(30 * var(--u)); font-size: calc(20 * var(--u)); font-weight: 330; line-height: 1.1; }
  .stage .actions a { color: var(--hero-ink); text-decoration: none; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 320ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .stage .actions a:hover, .stage .actions a:focus-visible { background-size: 100% 1px; }
  .stage a:focus-visible { outline-color: var(--hero-ink); }

  .stage .object { position: absolute; inset: 0; }
  .stage .paper { position: absolute; left: calc(var(--x) + 595 * var(--u)); top: calc(var(--y, 0px) + 160 * var(--u)); width: calc(525 * var(--u)); height: calc(548 * var(--u)); object-fit: cover; }

  /* The booking the paper turns into: glass cells in rising rows, tilted like the sheet they lifted from. */
  .cells {
    position: absolute; left: calc(var(--x) + 627 * var(--u)); top: calc(var(--y, 0px) + 171 * var(--u)); width: calc(420 * var(--u)); margin: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(7 * var(--u));
    transform: perspective(calc(1400 * var(--u))) rotateX(26deg) rotateZ(-8deg); transform-origin: 30% 100%;
  }
  .cell {
    display: grid; gap: calc(2 * var(--u)); padding: calc(8 * var(--u)) calc(10 * var(--u)); border-radius: calc(6 * var(--u));
    background: rgb(236 242 243 / 0.72); border: 1px solid rgb(255 255 255 / 0.7);
    box-shadow: 0 calc(6 * var(--u)) calc(14 * var(--u)) calc(-8 * var(--u)) rgb(20 18 16 / 0.35);
    backdrop-filter: blur(6px);
  }
  .cell dt { font-size: calc(11 * var(--u)); line-height: 1.1; color: #4f5a5c; }
  .cell dd { margin: 0; font-size: calc(14 * var(--u)); line-height: 1.2; color: #1d2426; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cell:nth-child(n + 4) { opacity: 0.9; }
  .cell:nth-child(n + 7) { opacity: 0.78; }

  .cards { list-style: none; margin: 0; padding: 0; }
  .card { position: absolute; }
  .card a {
    display: block; padding: calc(11 * var(--u)) calc(16 * var(--u)); border-radius: calc(8 * var(--u));
    font-size: calc(16 * var(--u)); line-height: 1.3; color: #1f1c1a; text-decoration: none;
    background: rgb(232 230 227 / 0.62); border: 1px solid rgb(255 255 255 / 0.55);
    box-shadow: 0 calc(8 * var(--u)) calc(22 * var(--u)) calc(-12 * var(--u)) rgb(20 18 16 / 0.5);
    backdrop-filter: blur(12px) saturate(1.1);
    transition: background-color 240ms ease-out, transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card a:hover, .card a:focus-visible { background-color: rgb(244 243 241 / 0.82); transform: translateY(calc(-2 * var(--u))); }
  .card.tours { left: calc(var(--x) + 1011 * var(--u)); top: calc(225 * var(--u)); }
  .card.lab { left: calc(var(--x) + 963 * var(--u)); top: calc(494 * var(--u)); }
  .card.caching { left: calc(var(--x) + 946 * var(--u)); top: calc(550 * var(--u)); width: calc(300 * var(--u)); }
  .card.caching b { display: block; font-weight: 400; font-size: calc(12 * var(--u)); color: #4a4541; }

  /* Phones and tablets: below 1024 px the comp cannot shrink and stay legible, so it unstacks into copy, then the object
     (cropped to the paper and its cells, still in comp pixels), then the cards as a plain list. */
  @container (max-width: 1023px) {
    .stage { height: auto; display: grid; padding: 7.5rem var(--gutter) 2rem; }
    .stage .backdrop-fill { display: none; }
    .stage .backdrop { left: 0; width: 100%; object-position: 42% 50%; filter: brightness(0.6) contrast(1.04); }
    .stage .copy { position: relative; left: auto; top: auto; width: auto; }
    .stage h1 { font-size: 2.6rem; }
    .stage .role { font-size: 1.3rem; white-space: normal; }
    .stage .lead { max-width: 20ch; margin-top: 1rem; font-size: 1.3rem; }
    .stage .actions { gap: 1.4rem; margin-top: 1.25rem; font-size: 1.05rem; }
    .stage .object {
      --u: min((100cqw - 2 * var(--gutter)) / 580, 1px); --x: calc((100cqw - 2 * var(--gutter) - 580 * var(--u)) / 2 - 570 * var(--u)); --y: calc(-150 * var(--u)); position: relative; inset: auto; height: calc(560 * var(--u)); margin-top: 1.5rem; }
    .cards { position: relative; display: grid; gap: 0.6rem; justify-items: start; }
    .stage .card { position: static; width: auto; }
    .card a { padding: 0.7rem 1rem; border-radius: 8px; font-size: 0.95rem; box-shadow: 0 8px 22px -12px rgb(20 18 16 / 0.5); }
    .card.caching b { font-size: 0.78rem; }
    .cell dt { font-size: max(calc(11 * var(--u)), 8px); }
    .cell dd { font-size: max(calc(14 * var(--u)), 10px); }
  }
  /* Tablets: copy and cards on the left, the object beside them, so the first viewport is not one tall column. */
  @container (min-width: 640px) and (max-width: 1023px) {
    .stage { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); grid-template-areas: "copy object" "cards object"; column-gap: 1.5rem; align-items: start; padding-top: 8rem; }
    .stage .copy { grid-area: copy; }
    .stage h1 { font-size: 3.2rem; }
    .stage .role { font-size: 1.5rem; }
    .stage .lead { font-size: 1.45rem; }
    .stage .cards { grid-area: cards; margin-top: 2rem; }
    .stage .object {
      grid-area: object; margin-top: 0;
      --u: calc((55cqw - var(--gutter) - 0.75rem) / 580); --x: calc(-570 * var(--u));
    }
  }

  .hero-depth { display: grid; gap: 2rem; padding-block: 3rem 1.5rem; }
  .facts div:last-child { border-bottom: 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .btn {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.3rem; border-radius: 999px;
    border: 1px solid var(--color-fg); color: var(--color-fg); text-decoration: none; font-weight: 500;
    transition: background-color 240ms ease-out, color 240ms ease-out, transform 240ms ease-out;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn.primary { background: var(--color-fg); color: var(--color-bg); }
  .facts { margin: 0; display: grid; border-top: 1px solid var(--color-line); font-family: var(--font-mono); font-size: var(--step--1); }
  .facts div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding-block: 0.7rem; border-bottom: 1px solid var(--color-line); }
  .facts dt { color: var(--color-faint); text-transform: uppercase; letter-spacing: 0.08em; }
  .facts dd { margin: 0; color: var(--color-fg); }
  @media (max-width: 600px) { .facts div { grid-template-columns: 1fr; gap: 0.2rem; } }

  /* ---------- sections: the hero's studio carried down the page ----------
     Documents are paper (#f1f2f2) or white; scenes are the studio grey (#766f6a) and its shadow (#2a2724).
     Cells take 8 px corners like the hero's glass, panels 18 px. Rhythm comes from space, never from rules between sections. */
  .home { --studio: #766f6a; --studio-shadow: #2a2724; --paper: #f1f2f2; --panel-r: 18px; --cell-r: 8px; }
  .home section.block { border-top: 0; padding-block: clamp(3.5rem, 7vw, 6rem) 0; gap: 2rem; }
  :root:not([data-dimension="depth"]) .home :is(.head h2, .work-h) {
    font-family: var(--font-body); font-size: clamp(2rem, 1.4rem + 1.9vw, 2.75rem); line-height: 1.1; letter-spacing: -0.015em; max-width: 22ch;
  }

  /* ---------- selected work: starts on the first viewport, right under the hero ---------- */
  .home section.block.work { padding-top: 3.1rem; gap: 1.5rem; }
  /* On desktop the heading holds one line so the case cards start inside the first viewport, as in the comp. */
  @media (min-width: 1024px) { :root:not([data-dimension="depth"]) .home h2.work-h { max-width: none; } }
  .cases { display: grid; gap: 1.25rem; }
  @media (min-width: 860px) { .cases { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .home .case {
    border: 0; border-radius: var(--panel-r); padding: clamp(1.4rem, 3vw, 2.25rem); gap: 1.4rem; align-content: start;
    box-shadow: 0 1px 0 var(--color-line), 0 24px 48px -32px rgb(42 39 36 / 0.45);
  }
  :root:not([data-dimension="depth"]) .home .case h3 { font-family: var(--font-body); font-size: clamp(1.7rem, 1.3rem + 1.2vw, 2.25rem); line-height: 1.1; letter-spacing: -0.015em; }
  :root[data-dimension="depth"] .home .case h3 { line-height: 1.15; }
  .home .case .status {
    display: inline-flex; align-items: center; gap: 0.45rem; padding: 0; border: 0;
    font-family: var(--font-body); font-size: 0.82rem; text-transform: none; letter-spacing: 0;
  }
  .home .case .status::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  /* Each facet reads as a field on a record: its name on the left, the fact on the right. */
  .home .case .facets { grid-template-columns: 1fr; gap: 0; }
  .home .facet { grid-template-columns: 6.5rem minmax(0, 1fr); gap: 0.25rem 1rem; padding-block: 1rem; border-top: 1px solid var(--color-line); }
  .home .facet .label { font-size: 0.82rem; font-weight: 500; line-height: 1.6; color: var(--color-fg); }
  .home .facet p { font-size: 1rem; line-height: 1.55; color: var(--color-muted); max-width: 52ch; }
  @media (max-width: 480px) { .home .facet { grid-template-columns: 1fr; } }
  :root:not([data-dimension="depth"]) .home .case:nth-child(2) { background: var(--studio); color: #fff; box-shadow: 0 24px 48px -32px rgb(42 39 36 / 0.6); }
  :root:not([data-dimension="depth"]) .home .case:nth-child(2) :is(.facet p, .facet .label, .status) { color: #fff; }
  :root:not([data-dimension="depth"]) .home .case:nth-child(2) .facet { border-top-color: rgb(255 255 255 / 0.3); }

  /* ---------- lab door: the studio's shadow, with the replayed audit laid on it as a sheet of paper ---------- */
  .lab { display: grid; gap: 1.5rem; }
  .lab-door {
    display: grid; gap: 1.5rem 3rem; align-items: start; padding: clamp(1.5rem, 4vw, 3rem); border-radius: var(--panel-r);
    background: var(--studio-shadow); color: #f1f0ee;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); grid-template-areas: "head sheet" "foot sheet";
  }
  .lab-door .head { grid-area: head; gap: 1rem; }
  .home .lab-door h2 { color: #f6f5f3; }
  .home .lab-door .head p { color: #d2cdc7; font-size: 1.06rem; max-width: 46ch; }
  .lab-foot { grid-area: foot; align-self: end; display: grid; justify-items: start; gap: 0.9rem; max-width: 44ch; color: #b9b3ac; font-size: 0.92rem; }
  .receipt-sheet {
    grid-area: sheet; margin: 0; padding: 1.1rem 1.3rem 0.4rem; border-radius: var(--cell-r);
    background: var(--paper); color: #1d2426; box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.75); transform: rotate(-1.2deg);
  }
  .receipt-sheet figcaption { display: grid; gap: 0.15rem; padding-bottom: 0.8rem; border-bottom: 1px solid #c9cece; }
  .receipt-sheet figcaption b { font-family: var(--font-mono); font-weight: 400; font-size: 0.86rem; }
