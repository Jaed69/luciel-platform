---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';

const stops = [
  { when: '2017 – 2022', color: 'wine', title: 'Basílica Café', place: 'Cusco', text: 'Freelance tech solutions: automated demand reports for management and an ETL from the sales system into a central database.' },
  { when: '2022 – now', color: 'ochre', title: 'Computer Science', place: 'UPC', text: 'Data science, machine learning and generative AI.' },
  { when: 'Oct 2024 – Jun 2025', color: 'sage', title: 'President', place: 'IEEE CIS UPC', text: "Led the chapter's project portfolio and its industry partnerships." },
  { when: 'Jul – Sep 2025', color: 'moss', title: 'Project Director', place: 'IEEE ComSoc UPC', text: 'Led a multidisciplinary team building an IoT inventory system with a microservice architecture.' },
  { when: 'Oct 2025 – Mar 2026', color: 'rust', title: 'Intern', place: 'Credicorp Capital', text: 'Processes and technology for Wealth Management: Power BI dashboards, SQL optimisation, Databricks migration support and SSIS ETL.' },
  { when: 'Mar 2026 – now', color: 'amber', title: 'Full-stack & GenAI developer', place: 'UPC', text: 'The accreditation assistant above.' },
];

const stack = [
  { label: 'ML & deep learning', items: ['Python', 'pandas', 'scikit-learn', 'PyTorch', 'TensorFlow'] },
  { label: 'LLMs', items: ['Amazon Bedrock', 'LangChain', 'prompt caching'] },
  { label: 'Data', items: ['SQL', 'PostgreSQL', 'Databricks', 'Power BI'] },
  { label: 'Systems', items: ['FastAPI', 'Docker', 'Traefik', 'AWS'] },
];
---

<Layout
  title="Jhamil Peña | luciel.dev"
  description="Jhamil Peña, Computer Science student in Lima. A productized portfolio of real, working web tools."
>
  <main class="wrap">
    <section id="intro" class="hero" aria-labelledby="name">
      <h1 id="name">Jhamil<br /><span class="last">Peña</span></h1>
      <div class="role">
        <span>AI / ML engineer</span><span class="dot" aria-hidden="true">●</span>
        <span>Computer Science, UPC</span><span class="dot" aria-hidden="true">●</span>
        <span>Lima, Peru</span>
      </div>
      <p class="thesis">I build tools that solve a real problem, each on its own subdomain, on infrastructure I can <em>rebuild from git</em>.</p>
      <div class="about">
        <p>
          I'm a Computer Science student at Universidad Peruana de Ciencias Aplicadas (UPC) in Lima, Peru, focused on
          data science, machine learning and generative AI. I work with Python (pandas, scikit-learn, PyTorch,
          TensorFlow), LangChain, SQL and Docker.
        </p>
        <p>
          Right now I'm building, with a classmate and under faculty supervision, an LLM-assisted system on Amazon
          Bedrock that analyses large volumes of unstructured documents for the faculty's accreditation process. It uses
          a FastAPI backend, async PostgreSQL, multi-phase batch processing and prompt caching.
        </p>
        <p>
          Before that I interned in Processes &amp; Technology for Wealth Management at Credicorp Capital (Power BI
          dashboards, SQL optimization, Databricks/Spark migration support, SSIS ETL). I have also led student tech
          communities as President of IEEE CIS UPC and Project Director at IEEE ComSoc UPC.
        </p>
      </div>
    </section>

    <section class="block" aria-labelledby="proof">
      <div class="head">
        <p class="eyebrow">Readouts</p>
        <h2 id="proof">Counted in the repo.</h2>
        <p>Every figure here comes from the code or from a check that runs on it.</p>
      </div>
      <div class="readouts">
        <div class="readout"><span class="val">1</span><span class="lbl">client running in production</span><span class="src">tours.luciel.dev</span></div>
        <div class="readout"><span class="val">144</span><span class="lbl">automated tests on that app</span><span class="src">68 vitest · 76 pytest</span></div>
        <div class="readout"><span class="val">~90%</span><span class="lbl">fewer system-prompt tokens with prompt caching</span><span class="src">accreditation system · CV</span></div>
        <div class="readout"><span class="val">&lt; 1 kB</span><span class="lbl">client JavaScript on this site</span><span class="src">a clock and a scroll counter</span></div>
      </div>
    </section>

    <section class="block" id="work" aria-labelledby="work-h">
      <div class="head">
        <p class="eyebrow">Selected work</p>
        <h2 id="work-h">What it runs on, and what it changed.</h2>
      </div>
      <div class="cases">
        <article class="case">
          <header><h3>tours</h3><span class="status live">Live · login only</span></header>
          <div class="facets">
            <div class="facet"><span class="eyebrow">Context</span><p>A tour agency and hotel in Cusco kept sales, commissions and settlements in Excel with VBA macros, and deleted rows left no trace.</p></div>
            <div class="facet"><span class="eyebrow">Approach</span><p>A double-entry ledger from day one. Every sale posts a balanced entry, checked in Python inside the transaction.</p></div>
            <div class="facet"><span class="eyebrow">System</span><p><code>Next.js</code> front end, <code>FastAPI</code> API, <code>SQLite</code> in WAL mode, role-based access and an audit log with before and after values.</p></div>
            <div class="facet"><span class="eyebrow">Outcome</span><p>In daily use by a real client. No public demo, so the source is the showcase.</p></div>
          </div>
          <footer><a href="https://github.com/Jaed69/luciel-platform/tree/main/apps/tours">Source ↗</a></footer>
        </article>
        <article class="case">
          <header><h3>Accreditation assistant</h3><span class="status build">In development · faculty project</span></header>
          <div class="facets">
            <div class="facet"><span class="eyebrow">Context</span><p>The faculty's accreditation process needs large volumes of unstructured documents analysed and audited.</p></div>
            <div class="facet"><span class="eyebrow">Approach</span><p>An LLM assistant on Amazon Bedrock with multi-phase batch sessions, live monitoring and automatic recovery after failures.</p></div>
            <div class="facet"><span class="eyebrow">System</span><p><code>FastAPI</code>, async <code>PostgreSQL</code>, role-based auth, persistent rate limiting, S3 backups and <code>AES-256-GCM</code> encryption.</p></div>
            <div class="facet"><span class="eyebrow">Outcome</span><p>Prompt caching cut system-prompt tokens by about 90% on repeated queries. Built with a classmate under faculty supervision.</p></div>
          </div>
        </article>
      </div>
    </section>

    <section class="block" id="trajectory" aria-labelledby="traj-h">
      <div class="head">
        <p class="eyebrow">Trajectory</p>
        <h2 id="traj-h">From a café in Cusco to production systems.</h2>
      </div>
      <ol class="track">
        {stops.map((stop) => (
          <li class="stop" style={`--c: var(--color-${stop.color})`}>
            <span class="when">{stop.when}</span>
            <div class="body">
              <h3><span>{stop.title}</span>, {stop.place}</h3>
              <p>{stop.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="block" id="stack" aria-labelledby="stack-h">
      <div class="head">
        <p class="eyebrow">Stack</p>
        <h2 id="stack-h">What I reach for.</h2>
      </div>
      <div class="stack">
        {stack.map((group) => (
          <div>
            <span class="eyebrow">{group.label}</span>
            <div class="chips">{group.items.map((item) => <span class="chip">{item}</span>)}</div>
          </div>
        ))}
      </div>
    </section>

    <section id="philosophy" class="block" aria-labelledby="philosophy-heading">
      <div class="head">
        <p class="eyebrow">Method</p>
        <h2 id="philosophy-heading">How this site works</h2>
      </div>
      <ul class="principles">
        <li>
          <h3>Real tools, not demos</h3>
          <p>Each project is a working tool that solves a real problem, not an empty demo.</p>
        </li>
        <li>
          <h3>One subdomain per tool</h3>
          <p>Every tool lives on its own subdomain, with genuine content written around it.</p>
        </li>
        <li>
          <h3>Reproducible infrastructure</h3>
          <p>Everything runs on infrastructure versioned in git: Traefik and Docker Compose, one container per app.</p>
        </li>
      </ul>
    </section>

    <section id="tools" class="block" aria-labelledby="tools-heading">
      <div class="head">
        <p class="eyebrow">Directory</p>
        <h2 id="tools-heading">Tools</h2>
      </div>
      <ul class="tool-list">
        {projects.map((project) => (
          <li>
            <span class="name">{project.name}</span>
            <span class:list={['tag', project.status === 'live' && 'is-live']}>{project.status === 'live' ? 'Live' : 'Coming soon'}</span>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/projects/">See details on the Projects page</a></p>
    </section>
  </main>
</Layout>

<style is:global>
  /* ---------- hero ---------- */
  .hero { padding-block: clamp(3rem, 8vw, 6.5rem) 3rem; display: grid; gap: 1.6rem; }
  .hero h1 { font-size: var(--step-3); font-weight: 800; line-height: 0.95; letter-spacing: -0.035em; }
  .hero h1 .last { color: var(--color-amber); }
  .role { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-muted); }
  .role .dot { color: var(--color-moss); }
  .thesis { font-size: var(--step-1); max-width: 34ch; font-family: var(--font-display); line-height: 1.35; }
  .thesis em { font-style: normal; color: var(--color-ochre); }
  .about { display: grid; gap: 1rem; max-width: 62ch; color: var(--color-muted); padding-top: 1rem; }

  /* ---------- readouts ---------- */
  .readouts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr)); gap: 1px; background: var(--color-line); border: 1px solid var(--color-line); }
  .readout { background: var(--color-surface); padding: 1.2rem 1.1rem; display: grid; gap: 0.35rem; align-content: start; }
  .readout .val { font-family: var(--font-mono); font-size: var(--step-2); font-variant-numeric: tabular-nums; line-height: 1; }
  .readout:nth-child(1) .val { color: var(--color-amber); }
  .readout:nth-child(2) .val { color: var(--color-sage); }
  .readout:nth-child(3) .val { color: var(--color-ochre); }
  .readout:nth-child(4) .val { color: var(--color-rust); }
  .readout .lbl { font-size: var(--step--1); }
  .readout .src { color: var(--color-faint); font-family: var(--font-mono); font-size: 0.75rem; }

  /* ---------- work ---------- */
  .cases { display: grid; gap: 1.2rem; }

  /* ---------- trajectory ---------- */
  .track { position: relative; display: grid; gap: 0; padding: 0 0 0 1.6rem; margin: 0; list-style: none; }
  .track::before { content: ""; position: absolute; left: 5px; top: 0.4rem; bottom: 0.4rem; width: 2px; background: var(--color-line); }
  .stop { position: relative; display: grid; grid-template-columns: 9.5rem 1fr; gap: 0.3rem 1.4rem; padding-block: 1rem; }
  .stop::before {
    content: ""; position: absolute; left: calc(-1.6rem + 1px); top: 1.45rem; width: 10px; height: 10px;
    border-radius: 50%; background: var(--c, var(--color-amber)); box-shadow: 0 0 0 4px var(--color-bg);
  }
  .stop .when { font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-muted); font-variant-numeric: tabular-nums; padding-top: 0.15rem; }
  .stop h3 { font-size: var(--step-1); font-weight: 600; }
  .stop h3 span { color: var(--c, var(--color-amber)); }
  .stop p { color: var(--color-muted); max-width: 62ch; }
  .stop .body { display: grid; gap: 0.3rem; min-width: 0; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* visible at rest; the dot swells and the title warms as each stop crosses the middle of the screen */
      .stop::before { animation: pulse linear both; animation-timeline: view(); animation-range: cover 30% cover 55%; }
      .stop h3 span { animation: warm linear both; animation-timeline: view(); animation-range: cover 25% cover 50%; }
      @keyframes pulse { from { transform: scale(0.6); } to { transform: scale(1.25); } }
      @keyframes warm { from { color: var(--color-muted); } to { color: var(--c, var(--color-amber)); } }
    }
  }
  @media (max-width: 600px) { .stop { grid-template-columns: 1fr; } }

  /* ---------- stack ---------- */
  .stack { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 1.4rem 2rem; }
  .stack > div { display: grid; gap: 0.5rem; min-width: 0; align-content: start; }

  /* ---------- philosophy and tools ---------- */
  .principles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 1.4rem 2rem; }
  .principles h3 { font-size: var(--step-1); font-weight: 600; }
  .principles p { color: var(--color-muted); margin-top: 0.3rem; }
  .tool-list { list-style: none; margin: 0; padding: 0; border-block: 1px solid var(--color-line); }
  .tool-list li { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-block: 0.8rem; }
  .tool-list li + li { border-top: 1px solid var(--color-line); }
  .tool-list .name { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; }
  .tool-list .tag { font-family: var(--font-mono); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-muted); }
  .tool-list .tag.is-live { color: var(--color-moss); }
  .more { font-family: var(--font-mono); font-size: var(--step--1); }
</style>
