---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';

const statusLabel = { live: 'Live', planned: 'Planned' } as const;
const live = projects.filter((p) => p.status === 'live');
const planned = projects.filter((p) => p.status === 'planned');
---

<Layout
  page="projects"
  title="Projects | luciel.dev"
  description="Tools built and planned on luciel.dev: what is live, what is login-only, and what is next."
>
  <main class="wrap page">
    <header class="page-head">
      <p class="eyebrow">Projects</p>
      <h1>What is live, and what is next.</h1>
      <p>
        Each tool lives in the <a href="https://github.com/Jaed69/luciel-platform">luciel-platform</a> monorepo and runs on its own subdomain.
      </p>
    </header>

    <section class="block" aria-labelledby="live-h">
      <h2 id="live-h" class="eyebrow">Live</h2>
      <div class="cases">
        {live.map((project) => (
          <article class="case" data-project={project.name} data-status={project.status}>
            <header>
              <h3>{project.name}</h3>
              <span class="status live">{statusLabel[project.status]}</span>
            </header>
            <p class="summary">{project.summary}</p>
            {project.stack.length > 0 && (
              <div class="chips">{project.stack.map((item) => <span class="chip">{item}</span>)}</div>
            )}
            {(project.url || project.sourceUrl) && (
              <footer>
                {project.url && <a href={project.url}>{project.url.replace('https://', '')}{project.access === 'login' ? ' (login required)' : ''}</a>}
                {project.sourceUrl && <a href={project.sourceUrl}>Source on GitHub</a>}
              </footer>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="planned-h">
      <h2 id="planned-h" class="eyebrow">Planned</h2>
      <div class="planned">
        {planned.map((project) => (
          <article class="mini" data-project={project.name} data-status={project.status}>
            <header>
              <h3>{project.name}</h3>
              <span class="status">{statusLabel[project.status]}</span>
            </header>
            <p>{project.summary}</p>
            {project.stack.length > 0 && (
              <div class="chips">{project.stack.map((item) => <span class="chip">{item}</span>)}</div>
            )}
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  .page { padding-block: clamp(2.5rem, 7vw, 5rem) 3rem; width: 100%; }
  .page-head { display: grid; gap: 0.9rem; padding-bottom: 2.5rem; }
  .page-head h1 { font-size: var(--step-3); font-weight: 800; line-height: 0.98; letter-spacing: -0.03em; }
  .page-head p:last-child { color: var(--color-muted); max-width: 60ch; }
  .case .summary { color: var(--color-muted); max-width: 66ch; }
  .case h3 { text-transform: none; }
  .planned { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 1rem; }
  .mini { border: 1px dashed var(--color-line); background: var(--color-surface); padding: 1.1rem; display: grid; gap: 0.6rem; align-content: start; }
  .mini header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.4rem 1rem; }
  .mini h3 { font-size: var(--step-1); font-weight: 600; }
  .mini p { color: var(--color-muted); font-size: 0.95rem; }
</style>
